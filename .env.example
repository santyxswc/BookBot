# ─── Copia este archivo como .env y rellena tus valores reales ────────────────
# cp .env.example .env

# Token del bot de Telegram (obtenlo en @BotFather)
TELEGRAM_TOKEN=TU_TOKEN_AQUI

# Directorio donde se guardan los archivos descargados temporalmente
TEMP_DOWNLOAD_DIR=downloads

# Límite de tamaño de archivo en MB (Telegram admite hasta 50 MB para bots)
MAX_FILE_SIZE_MB=50

# Enlace de donaciones opcional (ej: Ko-fi, BuyMeACoffee, PayPal)
DONATION_URL=https://ko-fi.com/santyxswc
